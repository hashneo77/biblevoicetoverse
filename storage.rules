rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /lyrics-text/{filename} {
      allow read: if true;
      allow write: if true;
    }
    match /media/{filename} {
      allow read: if true;
      allow write: if true;
    }
    match /holy-mass/{filename} {
      allow read: if true;
      allow write: if true;
    }
  }
}
