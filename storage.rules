rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only allowed accounts: the owner, or users with the `allowed` claim set by the
    // syncAccess Cloud Function from the database allow-list (config/access).
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'josephgeorge7797@gmail.com' || request.auth.token.allowed == true);
    }

    function isOwner() {
      return allowed() && request.auth.token.email == 'josephgeorge7797@gmail.com';
    }

    // Private uploads (media, slides, event-frame) record the uploader's uid in customMetadata.owner.
    // Only the uploader or the owner may delete them; older files without it are owner-only.
    function uploadedBySelf() {
      return allowed()
        && resource.metadata != null
        && resource.metadata.get('owner', '') == request.auth.uid;
    }

    function ownedByCaller() {
      return request.resource.metadata != null
        && request.resource.metadata.get('owner', '') == request.auth.uid;
    }

    // Image uploads from the remote: `<timestamp>-<random>.<ext>`, images only, max 20 MB
    function isNewImage(filename) {
      return allowed()
        && filename.matches('[0-9]{13}-[a-z0-9]+[.][A-Za-z0-9]{1,5}')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Reads use `get` only: object names are random, and nobody but the owner may list a folder,
    // so one user can't enumerate another user's uploads.

    // Song lyrics (Malayalam .txt and .manglish.txt): read only — edits and new songs are written by
    // the saveLyricsFile / saveSong functions, which check the editText / addSong features
    match /lyrics-text/{filename} {
      allow get: if allowed();
      allow list: if isOwner();
    }
    match /media/{filename} {
      allow get: if allowed();
      allow list: if isOwner();
      allow create: if isNewImage(filename) && ownedByCaller();
      allow delete: if isOwner() || uploadedBySelf();
    }
    // Slide decks from the remote: slides/<timestamp>-<random>/NNN.<ext>, images only, max 20 MB each
    match /slides/{deckId}/{filename} {
      allow get: if allowed();
      allow list: if isOwner();
      allow create: if allowed()
        && ownedByCaller()
        && deckId.matches('[0-9]{13}-[a-z0-9]+')
        && filename.matches('[0-9]{3}[.][a-z]{3,4}')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner() || uploadedBySelf();
    }
    // Event frame logos (uploaded by the owner from the remote)
    match /event-frame/{filename} {
      allow get: if allowed();
      allow list: if isOwner();
      allow create: if isNewImage(filename) && ownedByCaller();
      allow delete: if isOwner() || uploadedBySelf();
    }
    // Holy Mass pages are one shared book that every allowed user may edit (see database.rules.json)
    match /holy-mass/{filename} {
      allow get: if allowed();
      allow list: if isOwner();
      allow create: if isNewImage(filename);
      allow delete: if allowed();
    }
  }
}
