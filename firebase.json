{
  "functions": {
    "source": "functions"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/remote",
        "destination": "/remote/index.html"
      },
      {
        "source": "/remote/**",
        "destination": "/remote/index.html"
      }
    ]
  }
}
